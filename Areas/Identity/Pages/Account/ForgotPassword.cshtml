@page
@model ValavBoysWallet.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
<section class="recovery-shell">
    <div class="account-card">
        <span class="account-eyebrow">ACCOUNT RECOVERY</span>
        @if (!Model.EmailEnabled)
        {
            <h1 class="mt-3">Email services are unavailable</h1>
            <p>Email verification and password-reset emails are unavailable on this website. Contact the wallet administrator for help accessing your account.</p>
        }
        else if (Model.Submitted)
        {
            <h1 class="mt-3">Check your inbox</h1>
            <p role="status">If this address belongs to an account with a verified email, you will receive a password-reset link. Check your spam folder too.</p>
            <p>If no email arrives, contact the administrator for help verifying your email or checking delivery.</p>
        }
        else
        {
            <h1 class="mt-3">Forgot your password?</h1>
            <p>Enter your verified account email and we will send you a secure reset link.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <button type="submit" class="account-primary">Send reset link <i class="bi bi-arrow-right"></i></button>
            </form>
        }
        <p class="mt-4 mb-0"><a asp-page="./Login">Back to sign in</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
