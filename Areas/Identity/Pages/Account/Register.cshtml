@page
@model RegisterModel

@{
    ViewData["Title"] = "Create Account";
}

<style>

    /* =========================================================
           REGISTER PAGE
           ========================================================= */

    .auth-page {
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        padding: 42px 0;
    }

    .auth-shell {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
    }

    .auth-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(400px, .85fr);
        gap: 32px;
        align-items: stretch;
    }


    /* =========================================================
           FRIENDS PHOTO PANEL
           ========================================================= */

    .auth-intro {
        position: relative;
        min-height: 640px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 42px;
        border-radius: 26px;
        color: #fff;
        background-image: linear-gradient( 180deg, rgba(18, 19, 35, .02) 0%, rgba(18, 19, 35, .06) 25%, rgba(18, 19, 35, .30) 52%, rgba(18, 19, 35, .76) 76%, rgba(18, 19, 35, .96) 100% ), linear-gradient( 90deg, rgba(18, 19, 35, .24) 0%, rgba(18, 19, 35, .05) 60%, transparent 100% ), url("/images/valav-friends.png");
        background-size: cover;
        background-position: 52% center;
        background-repeat: no-repeat;
        box-shadow: 0 28px 60px rgba(23, 24, 46, .18);
    }

        .auth-intro::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            border-radius: inherit;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08);
        }


    /* =========================================================
           PHOTO CONTENT
           ========================================================= */

    .auth-intro-content {
        position: relative;
        z-index: 2;
        max-width: 510px;
    }

    .auth-brand-mark {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border-radius: 16px;
        color: #fff;
        background: linear-gradient( 135deg, #7969f6, #5946dd );
        box-shadow: 0 12px 28px rgba(75, 57, 214, .38);
        font-size: 24px;
    }

    .auth-intro h1 {
        max-width: 470px;
        margin: 0 0 16px;
        color: #fff;
        font-size: 37px;
        font-weight: 780;
        line-height: 1.12;
        letter-spacing: -1.25px;
        text-shadow: 0 2px 20px rgba(0, 0, 0, .18);
    }

    .auth-intro-description {
        max-width: 490px;
        margin: 0;
        color: rgba(255, 255, 255, .82);
        font-size: 13px;
        line-height: 1.75;
    }


    /* =========================================================
           FEATURES
           ========================================================= */

    .auth-feature-list {
        display: grid;
        gap: 11px;
        margin-top: 26px;
    }

    .auth-feature {
        display: flex;
        align-items: center;
        gap: 11px;
        color: rgba(255, 255, 255, .92);
        font-size: 11px;
        font-weight: 500;
    }

    .auth-feature-icon {
        width: 33px;
        height: 33px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 9px;
        color: #c7c0ff;
        background: rgba(103, 87, 232, .28);
        border: 1px solid rgba(255, 255, 255, .08);
        backdrop-filter: blur(8px);
    }


    /* =========================================================
           QUOTE
           ========================================================= */

    .auth-quote {
        position: relative;
        z-index: 2;
        margin-top: 25px;
        color: rgba(255, 255, 255, .58);
        font-size: 10px;
    }

        .auth-quote strong {
            color: #fff;
            font-weight: 700;
        }


    /* =========================================================
           REGISTER CARD
           ========================================================= */

    .auth-card {
        height: 100%;
        min-height: 640px;
        display: flex;
        flex-direction: column;
        padding: 38px;
        border: 1px solid #e8eaf2;
        border-radius: 26px;
        background: #fff;
        box-shadow: 0 18px 50px rgba(34, 40, 80, .075);
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .auth-card-header {
        margin-bottom: 25px;
    }

        .auth-card-header h2 {
            margin: 0 0 9px;
            color: #22273e;
            font-size: 28px;
            font-weight: 760;
            letter-spacing: -.75px;
        }

        .auth-card-header p {
            margin: 0;
            color: #949aaf;
            font-size: 12px;
            line-height: 1.65;
        }


    /* =========================================================
           VALIDATION
           ========================================================= */

    .auth-validation.validation-summary-errors {
        margin-bottom: 18px;
        padding: 12px 14px;
        border: 1px solid #f4cbd1;
        border-radius: 11px;
        color: #c73d52;
        background: #fff3f5;
        font-size: 10px;
    }

    .auth-validation ul {
        margin: 0;
        padding-left: 17px;
    }


    /* =========================================================
           FIELDS
           ========================================================= */

    .auth-field {
        margin-bottom: 16px;
    }

    .auth-label {
        display: block;
        margin-bottom: 8px;
        color: #4d546d;
        font-size: 10px;
        font-weight: 700;
    }

    .auth-input-wrap {
        position: relative;
    }

    .auth-input-icon {
        position: absolute;
        top: 50%;
        left: 15px;
        z-index: 2;
        transform: translateY(-50%);
        color: #939aae;
        font-size: 15px;
        pointer-events: none;
    }

    .auth-card .form-control {
        min-height: 50px;
        padding: 11px 15px 11px 45px;
        border: 1px solid #dfe3ed;
        border-radius: 12px;
        background: #fbfcfe;
        color: #3e455e;
        font-size: 12px;
        box-shadow: none;
        transition: border-color .18s ease, background-color .18s ease, box-shadow .18s ease;
    }

        .auth-card .form-control:hover {
            border-color: #d3d7e5;
        }

        .auth-card .form-control:focus {
            border-color: #9c91ee;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(103, 87, 232, .085);
        }

        .auth-card .form-control::placeholder {
            color: #afb4c6;
        }

    .auth-error {
        display: block;
        margin-top: 5px;
        color: #df4b60;
        font-size: 9px;
    }


    /* =========================================================
           CREATE BUTTON
           ========================================================= */

    .auth-submit {
        width: 100%;
        min-height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
        border: 0;
        border-radius: 12px;
        color: #fff;
        background: linear-gradient( 135deg, #7364ef, #5845db );
        font-size: 11px;
        font-weight: 700;
        box-shadow: 0 10px 24px rgba(103, 87, 232, .23);
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .auth-submit:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 14px 30px rgba(103, 87, 232, .3);
        }


    /* =========================================================
           LOGIN LINK
           ========================================================= */

    .auth-bottom {
        margin-top: 24px;
        padding-top: 21px;
        text-align: center;
        border-top: 1px solid #eef0f5;
        color: #9298ab;
        font-size: 10px;
    }

        .auth-bottom a {
            margin-left: 3px;
            color: #6757e8;
            font-weight: 700;
            text-decoration: none;
        }

            .auth-bottom a:hover {
                color: #5042d6;
            }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 991.98px) {

        .auth-shell {
            max-width: 620px;
        }

        .auth-layout {
            grid-template-columns: 1fr;
        }

        .auth-intro {
            min-height: 540px;
        }

        .auth-card {
            min-height: auto;
        }
    }

    @@media (max-width: 575.98px) {

        .auth-page {
            padding: 22px 0 30px;
        }

        .auth-layout {
            gap: 18px;
        }

        .auth-intro {
            min-height: 470px;
            padding: 25px 20px;
            border-radius: 20px;
            background-position: 52% center;
        }

        .auth-brand-mark {
            width: 46px;
            height: 46px;
            margin-bottom: 16px;
            border-radius: 13px;
            font-size: 20px;
        }

        .auth-intro h1 {
            font-size: 29px;
            letter-spacing: -.8px;
        }

        .auth-intro-description {
            font-size: 11px;
        }

        .auth-feature-list {
            margin-top: 21px;
        }

        .auth-feature {
            font-size: 10px;
        }

        .auth-feature-icon {
            width: 30px;
            height: 30px;
        }

        .auth-card {
            padding: 26px 20px;
            border-radius: 20px;
        }

        .auth-card-header {
            margin-bottom: 24px;
        }

            .auth-card-header h2 {
                font-size: 24px;
            }

        .auth-card .form-control {
            font-size: 16px;
        }
    }

</style>


<div class="container">

    <div class="auth-page">

        <div class="auth-shell">

            <div class="auth-layout">


                <!-- FRIENDS PHOTO PANEL -->

                <section class="auth-intro">

                    <div class="auth-intro-content">

                        <div class="auth-brand-mark">

                            <i class="bi bi-wallet2"></i>

                        </div>


                        <h1>

                            Good friends.<br />

                            Better times.<br />

                            Shared expenses.

                        </h1>


                        <p class="auth-intro-description">

                            Create your account and become part of
                            the shared wallet where every deposit,
                            expense and balance stays clear.

                        </p>



                        <div class="auth-feature-list">


                            <div class="auth-feature">

                                <span class="auth-feature-icon">

                                    <i class="bi bi-wallet2"></i>

                                </span>

                                <span>

                                    Keep group money organized

                                </span>

                            </div>



                            <div class="auth-feature">

                                <span class="auth-feature-icon">

                                    <i class="bi bi-receipt"></i>

                                </span>

                                <span>

                                    Track deposits and shared expenses

                                </span>

                            </div>



                            <div class="auth-feature">

                                <span class="auth-feature-icon">

                                    <i class="bi bi-shield-check"></i>

                                </span>

                                <span>

                                    Keep every transaction transparent

                                </span>

                            </div>


                        </div>

                    </div>



                    <div class="auth-quote">

                        Same people. Different bills.

                        <strong>

                            Stay together 💜

                        </strong>

                    </div>

                </section>



                <!-- REGISTER CARD -->

                <section class="auth-card">


                    <div class="auth-card-header">

                        <h2>

                            Create your account

                        </h2>

                        <p>

                            Join Valav Boys Wallet and start
                            tracking your shared money.

                        </p>

                    </div>



                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">


                        <div asp-validation-summary="ModelOnly"
                             class="auth-validation"
                             role="alert">
                        </div>



                        <!-- FULL NAME -->

                        <div class="auth-field">

                            <label asp-for="Input.FullName"
                                   class="auth-label">

                                Full Name

                            </label>


                            <div class="auth-input-wrap">

                                <i class="bi bi-person auth-input-icon"></i>

                                <input asp-for="Input.FullName"
                                       class="form-control"
                                       autocomplete="name"
                                       placeholder="Enter your full name"
                                       aria-required="true" />

                            </div>


                            <span asp-validation-for="Input.FullName"
                                  class="auth-error">
                            </span>

                        </div>



                        <!-- EMAIL -->

                        <div class="auth-field">

                            <label asp-for="Input.Email"
                                   class="auth-label">

                                Email Address

                            </label>


                            <div class="auth-input-wrap">

                                <i class="bi bi-envelope auth-input-icon"></i>

                                <input asp-for="Input.Email"
                                       class="form-control"
                                       autocomplete="username"
                                       placeholder="name@example.com"
                                       aria-required="true" />

                            </div>


                            <span asp-validation-for="Input.Email"
                                  class="auth-error">
                            </span>

                        </div>



                        <!-- PASSWORD -->

                        <div class="auth-field">

                            <label asp-for="Input.Password"
                                   class="auth-label">

                                Password

                            </label>


                            <div class="auth-input-wrap">

                                <i class="bi bi-lock auth-input-icon"></i>

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Create a password"
                                       aria-required="true" />

                            </div>


                            <span asp-validation-for="Input.Password"
                                  class="auth-error">
                            </span>

                        </div>



                        <!-- CONFIRM PASSWORD -->

                        <div class="auth-field">

                            <label asp-for="Input.ConfirmPassword"
                                   class="auth-label">

                                Confirm Password

                            </label>


                            <div class="auth-input-wrap">

                                <i class="bi bi-shield-lock auth-input-icon"></i>

                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Confirm your password"
                                       aria-required="true" />

                            </div>


                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="auth-error">
                            </span>

                        </div>



                        <!-- CREATE ACCOUNT -->

                        <button id="registerSubmit"
                                type="submit"
                                class="auth-submit">

                            <i class="bi bi-person-plus"></i>

                            Create Account

                        </button>


                    </form>



                    <!-- LOGIN LINK -->

                    <div class="auth-bottom">

                        Already a member?

                        <a asp-page="./Login"
                           asp-route-returnUrl="@Model.ReturnUrl">

                            Log in

                        </a>

                    </div>


                </section>


            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}