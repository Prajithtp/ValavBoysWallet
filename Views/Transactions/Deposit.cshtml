@model ValavBoysWallet.ViewModels.DepositRequestViewModel

@{
    ViewData["Title"] = "Deposit Request";
}

<style>

    /* =========================================================
           DEPOSIT REQUEST
           ========================================================= */

    .deposit-page {
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .deposit-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .deposit-title-wrap {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .deposit-title-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 14px;
        color: #16875d;
        background: #e3f7ed;
        font-size: 21px;
    }

    .deposit-page-header h1 {
        margin: 0;
        color: #20243f;
        font-size: 27px;
        font-weight: 750;
        letter-spacing: -.7px;
    }

    .deposit-page-header p {
        margin: 6px 0 0;
        color: #8c92a8;
        font-size: 13px;
    }

    .deposit-back-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 15px;
        border: 1px solid #e0e3ed;
        border-radius: 11px;
        color: #656c88;
        background: #fff;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
        transition: all .2s ease;
    }

        .deposit-back-btn:hover {
            color: #6757e8;
            border-color: #d3cdf8;
            background: #fbfaff;
            transform: translateY(-1px);
        }


    /* =========================================================
           GRID
           ========================================================= */

    .deposit-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 20px;
        align-items: start;
    }


    /* =========================================================
           FORM CARD
           ========================================================= */

    .deposit-form-card {
        border: 1px solid #e8eaf2;
        border-radius: 19px;
        background: #fff;
        box-shadow: 0 10px 32px rgba(37,44,80,.055);
        overflow: hidden;
    }

    .deposit-form-header {
        padding: 21px 22px;
        border-bottom: 1px solid #edf0f5;
    }

        .deposit-form-header h5 {
            margin: 0 0 4px;
            color: #30354f;
            font-size: 15px;
            font-weight: 700;
        }

        .deposit-form-header p {
            margin: 0;
            color: #969baf;
            font-size: 10px;
        }

    .deposit-form-body {
        padding: 22px;
    }


    /* =========================================================
           INFO NOTICE
           ========================================================= */

    .deposit-info {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-bottom: 21px;
        padding: 13px 14px;
        border: 1px solid #dcd7fb;
        border-radius: 12px;
        background: #f7f5ff;
    }

    .deposit-info-icon {
        width: 31px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 9px;
        color: #6757e8;
        background: #e9e5ff;
        font-size: 13px;
    }

    .deposit-info strong {
        display: block;
        margin-bottom: 2px;
        color: #5248a6;
        font-size: 10px;
        font-weight: 700;
    }

    .deposit-info span {
        color: #77749c;
        font-size: 9px;
        line-height: 1.55;
    }


    /* =========================================================
           FORM FIELDS
           ========================================================= */

    .deposit-field {
        margin-bottom: 18px;
    }

    .deposit-label {
        display: block;
        margin-bottom: 7px;
        color: #5f657e;
        font-size: 10px;
        font-weight: 650;
    }

    .deposit-input-wrap {
        position: relative;
    }

    .deposit-form-card .form-control {
        min-height: 43px;
        padding: 10px 12px;
        border: 1px solid #e0e3ec;
        border-radius: 10px;
        color: #454a63;
        background: #fbfcfe;
        font-size: 11px;
        box-shadow: none;
        transition: all .2s ease;
    }

        .deposit-form-card .form-control:focus {
            border-color: #a89df1;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(103,87,232,.09);
        }

        .deposit-form-card .form-control::placeholder {
            color: #b0b4c4;
        }

    .deposit-money-group {
        display: flex;
        align-items: stretch;
    }

    .deposit-currency {
        min-width: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e0e3ec;
        border-right: 0;
        border-radius: 10px 0 0 10px;
        color: #159566;
        background: #eefaf5;
        font-size: 13px;
        font-weight: 750;
    }

    .deposit-money-group .form-control {
        border-radius: 0 10px 10px 0;
    }

    .deposit-helper {
        display: block;
        margin-top: 6px;
        color: #999eb2;
        font-size: 9px;
        line-height: 1.5;
    }

    .deposit-validation {
        display: block;
        margin-top: 5px;
        color: #df4b60;
        font-size: 9px;
    }


    /* =========================================================
           FILE UPLOAD
           ========================================================= */

    .deposit-upload-box {
        padding: 16px;
        border: 1px dashed #cbc6ef;
        border-radius: 13px;
        background: #faf9ff;
    }

    .deposit-upload-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
    }

    .deposit-upload-icon {
        width: 33px;
        height: 33px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #6757e8;
        background: #ece8ff;
        font-size: 13px;
    }

    .deposit-upload-heading strong {
        color: #50566e;
        font-size: 10px;
    }

    .deposit-upload-heading span {
        display: block;
        margin-top: 2px;
        color: #999eb2;
        font-size: 8px;
    }

    .deposit-upload-box .form-control {
        background: #fff;
    }


    /* =========================================================
           SUBMIT BUTTON
           ========================================================= */

    .deposit-submit-btn {
        width: 100%;
        min-height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 22px;
        border: 0;
        border-radius: 11px;
        color: #fff;
        background: linear-gradient(135deg, #24a975, #16865d);
        font-size: 11px;
        font-weight: 700;
        box-shadow: 0 8px 18px rgba(22, 134, 93, .17);
        transition: all .2s ease;
    }

        .deposit-submit-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 11px 22px rgba(22, 134, 93, .22);
        }


    /* =========================================================
           VALIDATION SUMMARY
           ========================================================= */

    .deposit-validation-summary.validation-summary-errors {
        margin-bottom: 18px;
        padding: 11px 13px;
        border: 1px solid #f5c9d0;
        border-radius: 10px;
        color: #c43f54;
        background: #fff3f5;
        font-size: 9px;
    }

    .deposit-validation-summary ul {
        margin: 0;
        padding-left: 18px;
    }


    /* =========================================================
           SIDE PANEL
           ========================================================= */

    .deposit-side-card {
        padding: 20px;
        border: 1px solid #e8eaf2;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(37,44,80,.05);
    }

    .deposit-side-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        border-radius: 13px;
        color: #6757e8;
        background: #eeeaff;
        font-size: 18px;
    }

    .deposit-side-card h5 {
        margin: 0 0 6px;
        color: #30354f;
        font-size: 14px;
        font-weight: 700;
    }

    .deposit-side-card > p {
        margin: 0 0 18px;
        color: #969baf;
        font-size: 9px;
        line-height: 1.6;
    }

    .deposit-step {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 15px;
    }

        .deposit-step:last-child {
            margin-bottom: 0;
        }

    .deposit-step-number {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 9px;
        color: #6757e8;
        background: #eeeaff;
        font-size: 9px;
        font-weight: 750;
    }

    .deposit-step strong {
        display: block;
        margin-bottom: 2px;
        color: #50566e;
        font-size: 9px;
        font-weight: 650;
    }

    .deposit-step span {
        color: #9ca1b4;
        font-size: 8px;
        line-height: 1.5;
    }


    /* =========================================================
           SECURITY NOTE
           ========================================================= */

    .deposit-security {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 14px;
        padding: 13px;
        border-radius: 12px;
        color: #777b91;
        background: #f6f7fa;
        font-size: 8px;
        line-height: 1.55;
    }

        .deposit-security i {
            margin-top: 1px;
            color: #6757e8;
            font-size: 12px;
        }

    /* =========================================================
       PAYMENT QR
       ========================================================= */

    .deposit-qr-card {
        background: #ffffff;
        border: 1px solid #e9e7f5;
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 20px;
        box-shadow: 0 8px 24px rgba(32, 24, 75, 0.06);
    }

    .deposit-qr-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .deposit-qr-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1efff;
        color: #6757e8;
        font-size: 20px;
        flex-shrink: 0;
    }

    .deposit-qr-header h5 {
        margin: 0 0 3px;
        font-size: 16px;
        font-weight: 700;
    }

    .deposit-qr-header p {
        margin: 0;
        color: #7b7890;
        font-size: 13px;
    }

    .deposit-qr-image-wrap {
        display: flex;
        justify-content: center;
        padding: 12px;
        margin-bottom: 16px;
        background: #fafafa;
        border: 1px dashed #ddd9f3;
        border-radius: 15px;
    }

    .deposit-qr-image {
        display: block;
        width: 100%;
        max-width: 210px;
        height: auto;
        border-radius: 10px;
    }

    .deposit-qr-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 12px;
        background: #f8f7ff;
        border-radius: 12px;
        color: #666276;
        font-size: 12px;
        line-height: 1.55;
    }

        .deposit-qr-note i {
            color: #6757e8;
            margin-top: 2px;
            flex-shrink: 0;
        }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 991.98px) {

        .deposit-layout {
            grid-template-columns: 1fr;
        }

        .deposit-side-card {
            order: initial;
        }
    }

    @@media (max-width: 767.98px) {

        .deposit-page-header {
            flex-direction: column;
        }

            .deposit-page-header h1 {
                font-size: 23px;
            }

        .deposit-back-btn {
            width: 100%;
        }

        .deposit-form-body,
        .deposit-form-header {
            padding: 18px;
        }
    }

</style>


<div class="deposit-page">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="deposit-page-header">

        <div class="deposit-title-wrap">

            <div class="deposit-title-icon">
                <i class="bi bi-arrow-down-left-circle"></i>
            </div>

            <div>

                <h1>
                    Deposit Request
                </h1>

                <p>
                    Submit your payment details for admin approval.
                </p>

            </div>

        </div>


        <a asp-controller="Wallet"
           asp-action="Dashboard"
           class="deposit-back-btn">

            <i class="bi bi-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>



    <!-- =====================================================
         MAIN LAYOUT
         ===================================================== -->

    <div class="deposit-layout">


        <!-- =================================================
             FORM
             ================================================= -->

        <div class="deposit-form-card">


            <div class="deposit-form-header">

                <h5>
                    Payment Information
                </h5>

                <p>
                    Enter the details exactly as they appear in your transaction.
                </p>

            </div>


            <div class="deposit-form-body">


                <!-- APPROVAL NOTICE -->

                <div class="deposit-info">

                    <div class="deposit-info-icon">
                        <i class="bi bi-info-circle"></i>
                    </div>

                    <div>

                        <strong>
                            Admin approval required
                        </strong>

                        <span>
                            Your wallet balance will not change until an
                            administrator verifies and approves this request.
                        </span>

                    </div>

                </div>



                <!-- FORM -->

                <form asp-controller="Transactions"
                      asp-action="Deposit"
                      method="post"
                      enctype="multipart/form-data">


                    <div asp-validation-summary="ModelOnly"
                         class="deposit-validation-summary">
                    </div>



                    <!-- =====================================
                         AMOUNT
                         ===================================== -->

                    <div class="deposit-field">

                        <label asp-for="Amount"
                               class="deposit-label">
                        </label>


                        <div class="deposit-money-group">

                            <span class="deposit-currency">
                                ₹
                            </span>

                            <input asp-for="Amount"
                                   class="form-control"
                                   placeholder="Enter deposit amount" />

                        </div>


                        <span asp-validation-for="Amount"
                              class="deposit-validation">
                        </span>

                    </div>



                    <!-- =====================================
                         REFERENCE
                         ===================================== -->

                    <div class="deposit-field">

                        <label asp-for="ReferenceNumber"
                               class="deposit-label">
                        </label>


                        <input asp-for="ReferenceNumber"
                               class="form-control"
                               placeholder="Example: 425689123456" />


                        <span asp-validation-for="ReferenceNumber"
                              class="deposit-validation">
                        </span>


                        <span class="deposit-helper">

                            <i class="bi bi-info-circle me-1"></i>

                            Enter the UPI or bank transaction reference ID.

                        </span>

                    </div>



                    <!-- =====================================
                         TRANSACTION DATE
                         ===================================== -->

                    <div class="deposit-field">

                        <label asp-for="TransactionDate"
                               class="deposit-label">
                        </label>


                        <input asp-for="TransactionDate"
                               class="form-control" />


                        <span asp-validation-for="TransactionDate"
                              class="deposit-validation">
                        </span>


                        <span class="deposit-helper">

                            <i class="bi bi-calendar3 me-1"></i>

                            Select the date when the payment was actually made.

                        </span>

                    </div>



                    <!-- =====================================
                         SCREENSHOT
                         ===================================== -->

                    <div class="deposit-field">

                        <label asp-for="Screenshot"
                               class="deposit-label">
                        </label>


                        <div class="deposit-upload-box">

                            <div class="deposit-upload-heading">

                                <div class="deposit-upload-icon">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                </div>

                                <div>

                                    <strong>
                                        Payment Screenshot
                                    </strong>

                                    <span>
                                        Upload proof of your completed payment
                                    </span>

                                </div>

                            </div>


                            <input asp-for="Screenshot"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />


                            <span asp-validation-for="Screenshot"
                                  class="deposit-validation">
                            </span>


                            <span class="deposit-helper">

                                JPG, JPEG, PNG or WEBP · Maximum size 5 MB

                            </span>

                        </div>

                    </div>



                    <!-- =====================================
                         SUBMIT
                         ===================================== -->

                    <button type="submit"
                            class="deposit-submit-btn">

                        <i class="bi bi-send-check"></i>

                        Submit Deposit Request

                    </button>


                </form>

            </div>

        </div>

        <!-- =================================================
        PAYMENT QR
        ================================================= -->

        <div class="deposit-qr-card">

            <div class="deposit-qr-header">
                <div class="deposit-qr-icon">
                    <i class="bi bi-qr-code"></i>
                </div>

                <div>
                    <h5>Scan to Pay</h5>
                    <p>Pay using any supported UPI app</p>
                </div>
            </div>

            <div class="deposit-qr-image-wrap">
                <img src="~/images/payment-qr.png"
                     asp-append-version="true"
                     alt="Payment QR Code"
                     class="deposit-qr-image" />
            </div>

            <div class="deposit-qr-note">
                <i class="bi bi-info-circle"></i>

                <span>
                    Scan the QR code, complete your payment, then enter the
                    transaction reference and upload the payment screenshot.
                </span>
            </div>

        </div>

        <!-- =================================================
             SIDE GUIDE
             ================================================= -->

        <div>


            <div class="deposit-side-card">

                <div class="deposit-side-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h5>
                    How it works
                </h5>

                <p>
                    Your deposit is added to the wallet only after verification.
                </p>



                <div class="deposit-step">

                    <div class="deposit-step-number">
                        1
                    </div>

                    <div>

                        <strong>
                            Make the payment
                        </strong>

                        <span>
                            Complete your payment using the group's payment method.
                        </span>

                    </div>

                </div>



                <div class="deposit-step">

                    <div class="deposit-step-number">
                        2
                    </div>

                    <div>

                        <strong>
                            Submit proof
                        </strong>

                        <span>
                            Enter the reference, payment date and upload a screenshot.
                        </span>

                    </div>

                </div>



                <div class="deposit-step">

                    <div class="deposit-step-number">
                        3
                    </div>

                    <div>

                        <strong>
                            Admin review
                        </strong>

                        <span>
                            An administrator verifies the request before approval.
                        </span>

                    </div>

                </div>



                <div class="deposit-step">

                    <div class="deposit-step-number">
                        4
                    </div>

                    <div>

                        <strong>
                            Wallet updated
                        </strong>

                        <span>
                            Once approved, the amount is reflected in your wallet.
                        </span>

                    </div>

                </div>

            </div>



            <div class="deposit-security">

                <i class="bi bi-lock"></i>

                <span>
                    Make sure the payment screenshot clearly shows the
                    transaction details before submitting.
                </span>

            </div>


        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}