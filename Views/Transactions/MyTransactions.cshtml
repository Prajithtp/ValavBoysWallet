@using ValavBoysWallet.Models.Enums
@model IEnumerable<ValavBoysWallet.Models.WalletTransaction>

@{
    ViewData["Title"] = "My Transactions";

    var transactions = Model?.ToList()
        ?? new List<ValavBoysWallet.Models.WalletTransaction>();

    var totalCount = transactions.Count;

    var pendingCount = transactions.Count(x =>
        x.Status == TransactionStatus.Pending);

    var approvedCount = transactions.Count(x =>
        x.Status == TransactionStatus.Approved);

    var rejectedCount = transactions.Count(x =>
        x.Status != TransactionStatus.Pending &&
        x.Status != TransactionStatus.Approved);

    var totalDeposits = transactions
        .Where(x =>
            x.Type == TransactionType.Deposit &&
            x.Status == TransactionStatus.Approved)
        .Sum(x => x.Amount);

    var totalExpenses = transactions
        .Where(x =>
            x.Type != TransactionType.Deposit &&
            x.Status == TransactionStatus.Approved)
        .Sum(x => x.Amount);
}


<style>

    /* =========================================================
           MY TRANSACTIONS
           ========================================================= */

    .transactions-page {
        width: 100%;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .transactions-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 26px;
    }

    .transactions-title-wrap {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .transactions-title-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 14px;
        color: #6757e8;
        background: #eeeaff;
        font-size: 21px;
    }

    .transactions-page-header h1 {
        margin: 0;
        color: #20243f;
        font-size: 27px;
        font-weight: 750;
        letter-spacing: -.7px;
    }

    .transactions-page-header p {
        margin: 6px 0 0;
        color: #8c92a8;
        font-size: 13px;
    }

    .transactions-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .transaction-header-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 15px;
        border-radius: 11px;
        font-size: 12px;
        font-weight: 650;
        transition: all .2s ease;
    }

    .dashboard-btn {
        color: #656c88;
        border: 1px solid #e0e3ed;
        background: #fff;
    }

        .dashboard-btn:hover {
            color: #6757e8;
            border-color: #d3cdf8;
            background: #fbfaff;
            transform: translateY(-1px);
        }

    .new-deposit-btn {
        color: #fff;
        border: 1px solid #6757e8;
        background: linear-gradient( 135deg, #7162ec, #5d4bde );
        box-shadow: 0 7px 18px rgba(103, 87, 232, .20);
    }

        .new-deposit-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 10px 23px rgba(103, 87, 232, .27);
        }


    /* =========================================================
           SUCCESS ALERT
           ========================================================= */

    .transaction-alert {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-bottom: 19px;
        padding: 14px 16px;
        border: 0;
        border-radius: 13px;
        color: #177d58;
        background: #e7f8f0;
        font-size: 12px;
    }

        .transaction-alert i {
            margin-top: 1px;
            font-size: 17px;
        }


    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .transaction-summary-row {
        margin-bottom: 20px;
    }

    .transaction-summary-card {
        height: 100%;
        padding: 20px 21px;
        border: 1px solid #e9ebf3;
        border-radius: 17px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(37, 44, 80, .05);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .transaction-summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 13px 32px rgba(37, 44, 80, .08);
        }

    .transaction-summary-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .transaction-summary-label {
        margin: 0 0 7px;
        color: #8d93aa;
        font-size: 11px;
        font-weight: 550;
    }

    .transaction-summary-value {
        margin: 0;
        color: #252a47;
        font-size: 22px;
        font-weight: 750;
        letter-spacing: -.4px;
    }

        .transaction-summary-value.deposit {
            color: #159566;
        }

        .transaction-summary-value.expense {
            color: #df4b60;
        }

        .transaction-summary-value.pending {
            color: #c4872c;
        }

    .transaction-summary-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 13px;
        font-size: 18px;
    }

    .summary-icon-purple {
        color: #6858df;
        background: #eeeaff;
    }

    .summary-icon-green {
        color: #188d62;
        background: #e3f8ef;
    }

    .summary-icon-red {
        color: #dc4b60;
        background: #ffe7eb;
    }

    .summary-icon-orange {
        color: #d4912e;
        background: #fff3df;
    }


    /* =========================================================
           TRANSACTION PANEL
           ========================================================= */

    .transactions-panel {
        overflow: hidden;
        border: 1px solid #e8eaf2;
        border-radius: 19px;
        background: #fff;
        box-shadow: 0 10px 32px rgba(37, 44, 80, .055);
    }

    .transactions-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 21px 23px;
        border-bottom: 1px solid #edf0f5;
    }

        .transactions-panel-header h5 {
            margin: 0 0 4px;
            color: #252a47;
            font-size: 16px;
            font-weight: 700;
        }

        .transactions-panel-header p {
            margin: 0;
            color: #9297ad;
            font-size: 11px;
        }

    .transaction-count-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 20px;
        color: #6152d4;
        background: #eeeaff;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

        .transaction-count-pill i {
            font-size: 12px;
        }


    /* =========================================================
           TABLE
           ========================================================= */

    .wallet-transaction-table {
        width: 100%;
        margin: 0;
    }

        .wallet-transaction-table thead th {
            padding: 12px 20px;
            color: #8d92a8;
            background: #fafbfe;
            border: 0;
            border-bottom: 1px solid #edf0f5;
            font-size: 10px;
            font-weight: 650;
            text-transform: uppercase;
            letter-spacing: .35px;
            white-space: nowrap;
        }

        .wallet-transaction-table tbody td {
            padding: 16px 20px;
            color: #555b74;
            border-bottom: 1px solid #f0f1f5;
            font-size: 12px;
            vertical-align: middle;
        }

        .wallet-transaction-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .wallet-transaction-table tbody tr {
            transition: background .15s ease;
        }

            .wallet-transaction-table tbody tr:hover {
                background: #fbfbfe;
            }


    /* =========================================================
           DATE
           ========================================================= */

    .transaction-date-main {
        color: #484e68;
        font-weight: 650;
        white-space: nowrap;
    }

    .transaction-date-sub {
        display: block;
        margin-top: 4px;
        color: #999eb2;
        font-size: 9px;
        white-space: nowrap;
    }


    /* =========================================================
           TYPE
           ========================================================= */

    .transaction-type-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 120px;
    }

    .transaction-type-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 11px;
        font-size: 14px;
    }

        .transaction-type-icon.deposit {
            color: #168b60;
            background: #e3f8ef;
        }

        .transaction-type-icon.expense {
            color: #dc4a60;
            background: #ffe7eb;
        }

    .transaction-type-name {
        color: #41465f;
        font-weight: 650;
    }


    /* =========================================================
           DESCRIPTION
           ========================================================= */

    .transaction-reference {
        max-width: 280px;
    }

    .transaction-reference-main {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #454a63;
        font-weight: 600;
    }

    .transaction-reference-sub {
        margin-top: 3px;
        color: #999eb2;
        font-size: 9px;
    }

    .transaction-category {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 5px;
        padding: 4px 7px;
        border-radius: 20px;
        color: #747b95;
        background: #f1f3f8;
        font-size: 9px;
        font-weight: 600;
    }


    /* =========================================================
           AMOUNT
           ========================================================= */

    .transaction-amount {
        font-size: 12px;
        font-weight: 750;
        white-space: nowrap;
    }

        .transaction-amount.deposit {
            color: #159566;
        }

        .transaction-amount.expense {
            color: #df4b60;
        }


    /* =========================================================
           STATUS
           ========================================================= */

    .transaction-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

        .transaction-status::before {
            content: "";
            width: 5px;
            height: 5px;
            flex-shrink: 0;
            border-radius: 50%;
        }

    .status-pending {
        color: #ae741e;
        background: #fff2d9;
    }

        .status-pending::before {
            background: #e4a038;
        }

    .status-approved {
        color: #16875d;
        background: #e3f7ed;
    }

        .status-approved::before {
            background: #1ca56f;
        }

    .status-rejected {
        color: #cf4258;
        background: #ffe6ea;
    }

        .status-rejected::before {
            background: #e14c61;
        }


    /* =========================================================
           REJECTION REASON
           ========================================================= */

    .rejection-reason {
        max-width: 280px;
        display: flex;
        align-items: flex-start;
        gap: 6px;
        margin-top: 8px;
        padding: 8px 9px;
        border-radius: 9px;
        color: #c84559;
        background: #fff1f3;
        font-size: 9px;
        line-height: 1.45;
    }

        .rejection-reason i {
            margin-top: 1px;
            flex-shrink: 0;
        }

        .rejection-reason strong {
            font-weight: 700;
        }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .transactions-empty-state {
        padding: 65px 20px;
        text-align: center;
    }

    .transactions-empty-icon {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        border-radius: 20px;
        color: #6858df;
        background: #eeeaff;
        font-size: 27px;
    }

    .transactions-empty-state h5 {
        margin: 0 0 6px;
        color: #333850;
        font-size: 15px;
        font-weight: 700;
    }

    .transactions-empty-state p {
        margin: 0 0 17px;
        color: #969baf;
        font-size: 11px;
    }

    .empty-deposit-btn {
        min-height: 39px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 10px;
        color: #fff;
        background: linear-gradient( 135deg, #7162ec, #5d4bde );
        font-size: 11px;
        font-weight: 650;
    }

        .empty-deposit-btn:hover {
            color: #fff;
        }


    /* =========================================================
           FOOT MESSAGE
           ========================================================= */

    .transactions-foot-message {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 21px;
        color: #999eb2;
        font-size: 10px;
    }

        .transactions-foot-message i {
            color: #6757e8;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 991.98px) {

        .wallet-transaction-table {
            min-width: 820px;
        }
    }


    @@media (max-width: 767.98px) {

        .transactions-page-header {
            flex-direction: column;
        }

            .transactions-page-header h1 {
                font-size: 23px;
            }

        .transactions-header-actions {
            width: 100%;
        }

        .transaction-header-btn {
            flex: 1;
        }

        .transactions-panel-header {
            padding: 18px;
        }
    }


    @@media (max-width: 575.98px) {

        .transactions-page-header {
            margin-bottom: 20px;
        }

        .transactions-title-icon {
            width: 43px;
            height: 43px;
            font-size: 18px;
        }

        .transactions-page-header p {
            font-size: 11px;
            line-height: 1.55;
        }

        .transactions-header-actions {
            flex-direction: column;
        }

        .transaction-header-btn {
            width: 100%;
        }

        .transaction-summary-card {
            padding: 17px;
        }

        .transactions-panel-header {
            align-items: flex-start;
            gap: 12px;
        }

        .transaction-count-pill {
            flex-shrink: 0;
        }

        .table-responsive {
            -webkit-overflow-scrolling: touch;
        }

        .transactions-foot-message {
            padding: 0 12px;
            text-align: center;
            line-height: 1.5;
        }
    }

</style>


<div class="transactions-page">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="transactions-page-header">

        <div class="transactions-title-wrap">

            <div class="transactions-title-icon">
                <i class="bi bi-arrow-left-right"></i>
            </div>

            <div>

                <h1>
                    My Transactions
                </h1>

                <p>
                    Track your wallet requests, approvals and expenses.
                </p>

            </div>

        </div>


        <div class="transactions-header-actions">

            <a asp-controller="Wallet"
               asp-action="Dashboard"
               class="transaction-header-btn dashboard-btn">

                <i class="bi bi-grid"></i>

                Dashboard

            </a>


            <a asp-controller="Transactions"
               asp-action="Deposit"
               class="transaction-header-btn new-deposit-btn">

                <i class="bi bi-plus-lg"></i>

                New Deposit

            </a>

        </div>

    </div>



    <!-- =====================================================
         SUCCESS MESSAGE
         ===================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert
                        alert-dismissible
                        fade show
                        transaction-alert">

            <i class="bi bi-check-circle-fill"></i>

            <div class="flex-grow-1">
                @TempData["SuccessMessage"]
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }



    <!-- =====================================================
         SUMMARY CARDS
         ===================================================== -->

    <div class="row g-3 transaction-summary-row">


        <!-- TOTAL TRANSACTIONS -->

        <div class="col-xl-3 col-md-6">

            <div class="transaction-summary-card">

                <div class="transaction-summary-inner">

                    <div>

                        <p class="transaction-summary-label">
                            Total Transactions
                        </p>

                        <h3 class="transaction-summary-value">
                            @totalCount
                        </h3>

                    </div>

                    <div class="transaction-summary-icon
                                summary-icon-purple">

                        <i class="bi bi-receipt"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- APPROVED DEPOSITS -->

        <div class="col-xl-3 col-md-6">

            <div class="transaction-summary-card">

                <div class="transaction-summary-inner">

                    <div>

                        <p class="transaction-summary-label">
                            Approved Deposits
                        </p>

                        <h3 class="transaction-summary-value deposit">
                            ₹@totalDeposits.ToString("N2")
                        </h3>

                    </div>

                    <div class="transaction-summary-icon
                                summary-icon-green">

                        <i class="bi bi-arrow-down-left"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- APPROVED EXPENSES -->

        <div class="col-xl-3 col-md-6">

            <div class="transaction-summary-card">

                <div class="transaction-summary-inner">

                    <div>

                        <p class="transaction-summary-label">
                            Approved Expenses
                        </p>

                        <h3 class="transaction-summary-value expense">
                            ₹@totalExpenses.ToString("N2")
                        </h3>

                    </div>

                    <div class="transaction-summary-icon
                                summary-icon-red">

                        <i class="bi bi-arrow-up-right"></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- PENDING -->

        <div class="col-xl-3 col-md-6">

            <div class="transaction-summary-card">

                <div class="transaction-summary-inner">

                    <div>

                        <p class="transaction-summary-label">
                            Pending Requests
                        </p>

                        <h3 class="transaction-summary-value pending">
                            @pendingCount
                        </h3>

                    </div>

                    <div class="transaction-summary-icon
                                summary-icon-orange">

                        <i class="bi bi-hourglass-split"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         TRANSACTION HISTORY
         ===================================================== -->

    <div class="transactions-panel">


        <!-- PANEL HEADER -->

        <div class="transactions-panel-header">

            <div>

                <h5>
                    Transaction History
                </h5>

                <p>
                    All your wallet activity in one place.
                </p>

            </div>


            <span class="transaction-count-pill">

                <i class="bi bi-list-ul"></i>

                @totalCount Records

            </span>

        </div>



        <!-- TABLE -->
        @if (transactions.Any())
        {
            <div class="table-responsive">

                <table class="wallet-transaction-table">

                    <thead>

                        <tr>

                            <th>
                                Date
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Reference / Purpose
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var transaction in transactions)
                        {
                            var isDeposit =
                            transaction.Type ==
                            TransactionType.Deposit;

                            <tr>


                                <!-- =================================
                                     DATE
                                     ================================= -->

                                <td>

                                    @if (isDeposit)
                                    {
                                        var displayDate =
                                        transaction.TransactionDate
                                        ?? transaction.CreatedDate;

                                        <div class="transaction-date-main">
                                            @(displayDate.ToString("dd MMM yyyy"))
                                        </div>

                                        <span class="transaction-date-sub">
                                            Submitted:
                                            @(transaction.CreatedDate
                                                                            .ToLocalTime()
                                                                            .ToString("dd MMM, hh:mm tt"))
                            </span>
                                                        }
                                    else
                                    {
                                        <div class="transaction-date-main">
                                            @(transaction.CreatedDate
                                                                            .ToLocalTime()
                                                                            .ToString("dd MMM yyyy"))
                                                                                                 </div>

                                        <span class="transaction-date-sub">
                                            @(transaction.CreatedDate
                                                                            .ToLocalTime()
                                                                            .ToString("hh:mm tt"))
                            </span>
                                                        }

                                </td>



                                <!-- =================================
                                     TYPE
                                     ================================= -->

                                <td>

                                    <div class="transaction-type-cell">

                                        @if (isDeposit)
                                        {
                                            <div class="transaction-type-icon deposit">

                                                <i class="bi bi-arrow-down-left"></i>

                                            </div>

                                            <span class="transaction-type-name">
                                                Deposit
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="transaction-type-icon expense">

                                                <i class="bi bi-arrow-up-right"></i>

                                            </div>

                                            <span class="transaction-type-name">
                                                Expense
                                            </span>
                                        }

                                    </div>

                                </td>



                                <!-- =================================
                                     REFERENCE / PURPOSE
                                     ================================= -->

                                <td>

                                    <div class="transaction-reference">

                                        @if (isDeposit)
                                        {
                                            <div class="transaction-reference-main">

                                                @(transaction.ReferenceNumber
                                                                                    ?? "-")

                                </div>

                                            <div class="transaction-reference-sub">
                                                Payment reference
                                            </div>
                                                                }
                                        else
                                        {
                                            <div class="transaction-reference-main">

                                                @(transaction.Purpose
                                                                                    ?? "-")

                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                                                transaction.Category))
                                            {
                                                <span class="transaction-category">

                                                    <i class="bi bi-tag"></i>

                                                    @transaction.Category

                                                </span>
                                            }
                                            else
                                            {
                                                <div class="transaction-reference-sub">
                                                    Expense
                                                </div>
                                            }
                                        }

                                    </div>

                                </td>



                                <!-- =================================
                                     AMOUNT
                                     ================================= -->

                                <td>

                                    @if (isDeposit)
                                    {
                                        <span class="transaction-amount deposit">
                                            + ₹@transaction.Amount.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="transaction-amount expense">
                                            - ₹@transaction.Amount.ToString("N2")
                                        </span>
                                    }

                                </td>



                                <!-- =================================
                                     STATUS
                                     ================================= -->

                                <td>

                                    @if (transaction.Status ==
                                                                TransactionStatus.Pending)
                                    {
                                        <span class="transaction-status
                                                                 status-pending">

                                            Pending

                                        </span>
                                    }
                                    else if (transaction.Status ==
                                    TransactionStatus.Approved)
                                    {
                                        <span class="transaction-status
                                                                 status-approved">

                                            Approved

                                        </span>
                                    }
                                    else
                                    {
                                        <div>

                                            <span class="transaction-status
                                                                     status-rejected">

                                                Rejected

                                            </span>


                                            @if (!string.IsNullOrWhiteSpace(
                                                                            transaction.RejectionReason))
                                            {
                                                <div class="rejection-reason">

                                                    <i class="bi
                                                                              bi-info-circle">
                                                    </i>

                                                    <div>

                                                        <strong>
                                                            Reason:
                                                        </strong>

                                                        @transaction.RejectionReason

                                                    </div>

                                                </div>
                                            }

                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {

            <!-- =============================================
                 EMPTY STATE
                 ============================================= -->

            <div class="transactions-empty-state">

                <div class="transactions-empty-icon">

                    <i class="bi bi-wallet2"></i>

                </div>

                <h5>
                    No transactions yet
