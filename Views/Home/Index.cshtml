@{
    ViewData["Title"] = "Home";
}

<style>

    /* =========================================================
           ADMIN HOME / WELCOME PAGE
           ========================================================= */

    .home-page {
        display: grid;
        gap: 22px;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .home-hero {
        position: relative;
        min-height: 440px;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        padding: 36px;
        border-radius: 24px;
        background-image: linear-gradient( 90deg, rgba(15, 16, 30, .94) 0%, rgba(15, 16, 30, .76) 28%, rgba(15, 16, 30, .34) 52%, rgba(15, 16, 30, .10) 78%, rgba(15, 16, 30, .04) 100% ), linear-gradient( 180deg, rgba(15, 16, 30, .02) 0%, rgba(15, 16, 30, .08) 58%, rgba(15, 16, 30, .48) 100% ), url("/images/valav-home.png");
        background-size: cover;
        /* IMPORTANT — moves picture upward */
        background-position: center 28%;
        background-repeat: no-repeat;
        box-shadow: 0 22px 55px rgba(32, 36, 72, .14);
    }

        .home-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            border-radius: inherit;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08);
        }

    .home-hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 620px;
    }

    .home-admin-badge {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 16px;
        padding: 7px 12px;
        border-radius: 999px;
        color: #dedaff;
        background: rgba(103, 87, 232, .24);
        border: 1px solid rgba(255, 255, 255, .08);
        backdrop-filter: blur(8px);
        font-size: 11px;
        font-weight: 700;
    }

    .home-hero h1 {
        margin: 0;
        color: #fff;
        font-size: 42px;
        font-weight: 780;
        line-height: 1.08;
        letter-spacing: -1.2px;
        text-shadow: 0 3px 20px rgba(0, 0, 0, .2);
    }

        .home-hero h1 span {
            color: #8c7dff;
        }

    .home-hero-description {
        max-width: 560px;
        margin: 15px 0 0;
        color: rgba(255, 255, 255, .79);
        font-size: 13px;
        line-height: 1.7;
    }

    .home-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
        margin-top: 24px;
    }

    .home-hero-primary,
    .home-hero-secondary {
        min-height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 18px;
        border-radius: 11px;
        font-size: 11px;
        font-weight: 700;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
    }

    .home-hero-primary {
        color: #fff;
        background: linear-gradient( 135deg, #7869f4, #5947db );
        box-shadow: 0 10px 24px rgba(87, 68, 216, .30);
    }

        .home-hero-primary:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 14px 29px rgba(87, 68, 216, .37);
        }

    .home-hero-secondary {
        color: #fff;
        background: rgba(255, 255, 255, .08);
        border: 1px solid rgba(255, 255, 255, .18);
        backdrop-filter: blur(8px);
    }

        .home-hero-secondary:hover {
            color: #fff;
            background: rgba(255, 255, 255, .13);
        }

    .home-hero-quote {
        margin-top: 22px;
        color: rgba(255, 255, 255, .55);
        font-size: 10px;
    }

        .home-hero-quote strong {
            color: #fff;
        }


    /* =========================================================
           QUICK OVERVIEW CARDS
           ========================================================= */

    .home-overview-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .home-overview-card {
        min-height: 120px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px;
        border: 1px solid var(--tpw-border);
        border-radius: 18px;
        background: #fff;
        box-shadow: var(--tpw-shadow);
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .home-overview-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--tpw-shadow-hover);
        }

    .home-overview-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 14px;
        font-size: 20px;
    }

        .home-overview-icon.purple {
            color: #6959e8;
            background: #efeaff;
        }

        .home-overview-icon.green {
            color: #15945f;
            background: #e4f7ee;
        }

        .home-overview-icon.blue {
            color: #2878e8;
            background: #e9f2ff;
        }

        .home-overview-icon.orange {
            color: #e89317;
            background: #fff2df;
        }

    .home-overview-content small {
        display: block;
        margin-bottom: 5px;
        color: #9499ad;
        font-size: 10px;
        font-weight: 600;
    }

    .home-overview-content strong {
        display: block;
        color: #252a43;
        font-size: 16px;
        font-weight: 750;
    }

    .home-overview-content span {
        display: block;
        margin-top: 5px;
        color: #9298ac;
        font-size: 9px;
        line-height: 1.4;
    }


    /* =========================================================
           LOWER SECTION
           ========================================================= */

    .home-lower-grid {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 18px;
    }

    .home-panel {
        padding: 22px;
        border: 1px solid var(--tpw-border);
        border-radius: 18px;
        background: #fff;
        box-shadow: var(--tpw-shadow);
    }

    .home-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
    }

        .home-panel-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 750;
        }

        .home-panel-header p {
            margin: 4px 0 0;
            color: #969caf;
            font-size: 10px;
        }


    /* =========================================================
           WELCOME INFO
           ========================================================= */

    .home-info-box {
        min-height: 210px;
        display: flex;
        align-items: center;
        padding: 26px;
        border-radius: 16px;
        background: linear-gradient( 135deg, #f6f4ff, #fbfbff );
        border: 1px solid #ece9ff;
    }

    .home-info-inner {
        max-width: 560px;
    }

    .home-info-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        border-radius: 13px;
        color: #6858e7;
        background: #e9e4ff;
        font-size: 19px;
    }

    .home-info-box h4 {
        margin-bottom: 8px;
        font-size: 18px;
        font-weight: 750;
    }

    .home-info-box p {
        margin: 0;
        color: #7d849b;
        font-size: 11px;
        line-height: 1.7;
    }


    /* =========================================================
           QUICK ACTIONS
           ========================================================= */

    .home-actions {
        display: grid;
        gap: 10px;
    }

    .home-action {
        min-height: 65px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid #edf0f6;
        border-radius: 13px;
        color: inherit;
        background: #fafbfe;
        transition: transform .16s ease, border-color .16s ease, background .16s ease;
    }

        .home-action:hover {
            color: inherit;
            transform: translateX(2px);
            border-color: rgba(103, 87, 232, .18);
            background: #f8f6ff;
        }

    .home-action-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 11px;
        color: #6858e7;
        background: #ebe7ff;
        font-size: 16px;
    }

    .home-action-text {
        min-width: 0;
        flex: 1;
    }

        .home-action-text strong {
            display: block;
            color: #343951;
            font-size: 11px;
            font-weight: 700;
        }

        .home-action-text small {
            display: block;
            margin-top: 3px;
            color: #979daf;
            font-size: 9px;
        }

    .home-action-arrow {
        color: #9aa0b4;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1199.98px) {

        .home-overview-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {

        .home-lower-grid {
            grid-template-columns: 1fr;
        }

        .home-hero {
            min-height: 420px;
        }
    }

    @@media (max-width: 767.98px) {

        .home-hero {
            min-height: 430px;
            padding: 26px 22px;
            border-radius: 19px;
            background-position: 55% center;
        }

            .home-hero h1 {
                font-size: 32px;
            }

        .home-hero-description {
            font-size: 11px;
        }

        .home-overview-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {

        .home-page {
            gap: 16px;
        }

        .home-hero {
            min-height: 460px;
            padding: 24px 18px;
        }

            .home-hero h1 {
                font-size: 28px;
            }

        .home-hero-actions {
            flex-direction: column;
        }

        .home-hero-primary,
        .home-hero-secondary {
            width: 100%;
        }

        .home-overview-card {
            min-height: 105px;
        }

        .home-panel {
            padding: 17px;
        }
    }

</style>


<div class="home-page">


    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="home-hero">

        <div class="home-hero-content">


            <div class="home-admin-badge">

                <i class="bi bi-shield-check"></i>

                Admin

            </div>


            <h1>

                Welcome back to<br />

                Valav Boys <span>Wallet</span>

            </h1>


            <p class="home-hero-description">

                Same people. Different bills.
                Keep the money, memories and chaos organized
                from one place.

            </p>



            <div class="home-hero-actions">


                <a asp-controller="Wallet"
                   asp-action="Dashboard"
                   class="home-hero-primary">

                    <i class="bi bi-grid"></i>

                    View Dashboard

                    <i class="bi bi-arrow-right"></i>

                </a>


                <a asp-controller="Members"
                   asp-action="Index"
                   class="home-hero-secondary">

                    <i class="bi bi-people"></i>

                    Manage Members

                </a>


            </div>


            <div class="home-hero-quote">

                Good friends. Better times.
                Shared expenses.

                <strong>💜</strong>

            </div>


        </div>

    </section>



    <!-- =====================================================
         OVERVIEW
         ===================================================== -->

    <section class="home-overview-grid">


        <a asp-controller="Members"
           asp-action="Index"
           class="home-overview-card">

            <div class="home-overview-icon purple">

                <i class="bi bi-people"></i>

            </div>

            <div class="home-overview-content">

                <small>Members</small>

                <strong>Manage Group</strong>

                <span>
                    View member balances and contributions.
                </span>

            </div>

        </a>



        <a asp-controller="Wallet"
           asp-action="Dashboard"
           class="home-overview-card">

            <div class="home-overview-icon green">

                <i class="bi bi-wallet2"></i>

            </div>

            <div class="home-overview-content">

                <small>Wallet</small>

                <strong>Dashboard</strong>

                <span>
                    Review wallet balances and activity.
                </span>

            </div>

        </a>



        <a asp-controller="Transactions"
           asp-action="MyTransactions"
           class="home-overview-card">

            <div class="home-overview-icon blue">

                <i class="bi bi-arrow-left-right"></i>

            </div>

            <div class="home-overview-content">

                <small>Transactions</small>

                <strong>Transaction History</strong>

                <span>
                    Review deposits and expenses.
                </span>

            </div>

        </a>



        <a asp-controller="Admin"
           asp-action="Index"
           class="home-overview-card">

            <div class="home-overview-icon orange">

                <i class="bi bi-hourglass-split"></i>

            </div>

            <div class="home-overview-content">

                <small>Approvals</small>

                <strong>Approval Panel</strong>

                <span>
                    Review pending transaction requests.
                </span>

            </div>

        </a>


    </section>



    <!-- =====================================================
         LOWER AREA
         ===================================================== -->

    <section class="home-lower-grid">


        <!-- WELCOME PANEL -->

        <div class="home-panel">

            <div class="home-panel-header">

                <div>

                    <h3>
                        Your group wallet
                    </h3>

                    <p>
                        Everything important is only one click away.
                    </p>

                </div>

            </div>


            <div class="home-info-box">

                <div class="home-info-inner">

                    <div class="home-info-icon">

                        <i class="bi bi-stars"></i>

                    </div>

                    <h4>
                        Keep the chaos organized.
                    </h4>

                    <p>
                        Valav Boys Wallet keeps deposits, expenses,
                        member balances, approvals and group history
                        together so everyone can see where the money goes.
                    </p>

                </div>

            </div>

        </div>



        <!-- QUICK ACTIONS -->

        <div class="home-panel">

            <div class="home-panel-header">

                <div>

                    <h3>
                        Quick Actions
                    </h3>

                    <p>
                        Jump straight to an admin task.
                    </p>

                </div>

            </div>


            <div class="home-actions">


                <a asp-controller="Members"
                   asp-action="Index"
                   class="home-action">

                    <span class="home-action-icon">

                        <i class="bi bi-people"></i>

                    </span>

                    <span class="home-action-text">

                        <strong>
                            Manage Members
                        </strong>

                        <small>
                            View group member details.
                        </small>

                    </span>

                    <i class="bi bi-chevron-right home-action-arrow"></i>

                </a>



                <a asp-controller="Admin"
                   asp-action="Index"
                   class="home-action">

                    <span class="home-action-icon">

                        <i class="bi bi-check2-square"></i>

                    </span>

                    <span class="home-action-text">

                        <strong>
                            Approval Panel
                        </strong>

                        <small>
                            Review pending requests.
                        </small>

                    </span>

                    <i class="bi bi-chevron-right home-action-arrow"></i>

                </a>



                <a asp-controller="Passbook"
                   asp-action="Index"
                   class="home-action">

                    <span class="home-action-icon">

                        <i class="bi bi-journal-text"></i>

                    </span>

                    <span class="home-action-text">

                        <strong>
                            View Passbook
                        </strong>

                        <small>
                            See approved wallet history.
                        </small>

                    </span>

                    <i class="bi bi-chevron-right home-action-arrow"></i>

                </a>



                <a asp-controller="Admin"
                   asp-action="Reports"
                   class="home-action">

                    <span class="home-action-icon">

                        <i class="bi bi-bar-chart"></i>

                    </span>

                    <span class="home-action-text">

                        <strong>
                            Reports
                        </strong>

                        <small>
                            Review wallet insights and totals.
                        </small>

                    </span>

                    <i class="bi bi-chevron-right home-action-arrow"></i>

                </a>


            </div>

        </div>


    </section>


</div>