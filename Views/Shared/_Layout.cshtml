@using Microsoft.AspNetCore.Identity
@using ValavBoysWallet.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var homeReturnUrl = Url.Action(
        "Index",
        "Home",
        new { area = "" });

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    var isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    var isAdmin =
        User.IsInRole("Admin");

    var userName =
        User.Identity?.Name ?? "User";

    var accountUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
    var hasProfilePhoto = accountUser?.ProfilePhoto is { Length: > 0 };

    var userInitial =
        !string.IsNullOrWhiteSpace(userName)
            ? userName.Substring(0, 1).ToUpper()
            : "U";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Valav Boys Wallet
    </title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Global CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Razor scoped CSS -->
    <link rel="stylesheet"
          href="~/ValavBoysWallet.styles.css"
          asp-append-version="true" />

</head>


<body>

    @if (isAuthenticated)
    {
        <!-- =====================================================
             MOBILE OVERLAY
             ===================================================== -->

        <div class="tpw-sidebar-overlay"
             id="sidebarOverlay"
             onclick="closeSidebar()">
        </div>


        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <aside class="tpw-sidebar"
               id="mainSidebar">

            <!-- BRAND -->

            <div class="tpw-brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="tpw-brand-link">

                    <div class="tpw-brand-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>

                    <div class="tpw-brand-text">

                        <span>Valav Boys</span>

                        <strong>Wallet</strong>

                    </div>

                </a>

            </div>


            <!-- NAVIGATION -->

            <nav class="tpw-sidebar-nav">

                @if (isAdmin)
                {
                    <!-- ADMIN DASHBOARD -->

                    <a asp-controller="Admin"
                       asp-action="Dashboard"
                       class="tpw-nav-link
               @(currentController == "Admin" &&
                                               currentAction == "Dashboard"
                                                  ? "active"
                                                  : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-grid"></i>
                        </span>

                        <span>Dashboard</span>

                    </a>

                    <!-- MEMBERS -->

                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="tpw-nav-link
                       @(currentController == "Admin" &&
                                      (currentAction == "Users" ||
                                      currentAction == "MemberDetails")
                                      ? "active"
                                      : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-people"></i>
                        </span>

                        <span>Members</span>

                    </a>


                    <!-- MY TRANSACTIONS -->

                    <a asp-controller="Transactions"
                       asp-action="MyTransactions"
                       class="tpw-nav-link
                           @(currentController == "Transactions" &&
                                            currentAction == "MyTransactions"
                                               ? "active"
                                               : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-arrow-left-right"></i>
                        </span>

                        <span>Transactions</span>

                    </a>


                    <!-- APPROVAL PANEL -->

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="tpw-nav-link
                           @(currentController == "Admin" &&
                                            currentAction == "Index"
                                               ? "active"
                                               : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-check2-square"></i>
                        </span>

                        <span>Approval Panel</span>

                    </a>


                    <!-- PASSBOOK -->

                    <a asp-controller="Passbook"
                       asp-action="Index"
                       class="tpw-nav-link
                           @(currentController == "Passbook"
                                               ? "active"
                                               : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-journal-text"></i>
                        </span>

                        <span>Passbook</span>

                    </a>


                    <!-- REPORTS -->

                    <a asp-controller="Admin"
                       asp-action="Reports"
                       class="tpw-nav-link
                           @(currentController == "Admin" &&
                                            currentAction == "Reports"
                                               ? "active"
                                               : "")">

                <span class="tpw-nav-icon">
                    <i class="bi bi-bar-chart"></i>
                </span>

                        <span>Reports</span>

                    </a>
                        }
                else
                {
                    <!-- MEMBER DASHBOARD -->

                    <a asp-controller="Wallet"
                       asp-action="Dashboard"
                       class="tpw-nav-link
                           @(currentController == "Wallet" &&
                                            currentAction == "Dashboard"
                                               ? "active"
                                               : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-grid"></i>
                        </span>

                        <span>Dashboard</span>

                    </a>


                    <!-- DEPOSIT -->

                    <a asp-controller="Transactions"
                       asp-action="Deposit"
                       class="tpw-nav-link
                           @(currentController == "Transactions" &&
                                            currentAction == "Deposit"
                                               ? "active"
                                               : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-arrow-up-circle"></i>
                        </span>

                        <span>Deposit Request</span>

                    </a>


                    <!-- ADD EXPENSE -->

                    <a asp-controller="Transactions"
                       asp-action="Withdrawal"
                       class="tpw-nav-link
                           @(currentController == "Transactions" &&
                                            currentAction == "Withdrawal"
                                               ? "active"
                                               : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-arrow-down-circle"></i>
                        </span>

                        <span>Add Expense</span>

                    </a>


                    <!-- TRANSACTIONS -->

                    <a asp-controller="Transactions"
                       asp-action="MyTransactions"
                       class="tpw-nav-link
                           @(currentController == "Transactions" &&
                                            currentAction == "MyTransactions"
                                               ? "active"
                                               : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-arrow-left-right"></i>
                        </span>

                        <span>Transactions</span>

                    </a>


                    <!-- PASSBOOK -->

                    <a asp-controller="Passbook"
                       asp-action="Index"
                       class="tpw-nav-link
                           @(currentController == "Passbook"
                                               ? "active"
                                               : "")">

                        <span class="tpw-nav-icon">
                            <i class="bi bi-journal-text"></i>
                        </span>

                        <span>Passbook</span>

                    </a>


                    <!-- MEMBERS -->

                    <a asp-controller="Members"
                       asp-action="Index"
                       class="tpw-nav-link
                           @(currentController == "Members"
                                               ? "active"
                                               : "")">

                <span class="tpw-nav-icon">
                    <i class="bi bi-people"></i>
                </span>

                        <span>Members</span>

                    </a>
                        }

            </nav>


            <!-- SIDEBAR BOTTOM QUOTE -->

            <div class="tpw-sidebar-bottom">

                <div class="tpw-sidebar-quote">

                    <i class="bi bi-stars"></i>

                    <p>
                        “Good friends.<br />
                        Good transactions.”
                    </p>

                    <span>💜</span>

                </div>

            </div>

        </aside>


        <!-- =====================================================
             MAIN APPLICATION
             ===================================================== -->

        <div class="tpw-app">

            <!-- TOPBAR -->

            <header class="tpw-topbar">

                <div class="tpw-topbar-left">

                    <button type="button"
                            class="tpw-menu-button"
                            onclick="toggleSidebar()"
                            aria-label="Open navigation">

                        <i class="bi bi-list"></i>

                    </button>


                </div>


                <div class="tpw-topbar-right">

                    <!-- NOTIFICATION -->

                    @* <button type="button"
                            class="tpw-notification-button">

                        <i class="bi bi-bell"></i>

                        <span class="tpw-notification-dot"></span>

                    </button> *@


                    <!-- USER DROPDOWN -->

                    <div class="dropdown">

                        <button class="tpw-user-menu"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <span class="tpw-avatar">
                                @if (hasProfilePhoto)
                                {
                                    <img src="@Url.Action("Index", "ProfilePhoto", new { area = "" })"
                                         alt="Your profile photo"
                                         style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                                }
                                else
                                {
                                    @userInitial
                                }
                            </span>

                            <span class="tpw-user-info">

                                <strong>
                                    @userName
                                </strong>

                                <small>
                                    @(isAdmin ? "Admin" : "Member")
                                </small>

                            </span>

                            <i class="bi bi-chevron-down tpw-user-chevron"></i>

                        </button>


                        <ul class="dropdown-menu dropdown-menu-end
                                   tpw-profile-dropdown">

                            <li>

                                <a class="dropdown-item"
                                   asp-area="Identity"
                                   asp-page="/Account/Manage/Index">

                                    <i class="bi bi-person me-2"></i>

                                    My Account

                                </a>

                            </li>


                            <li>
                                <hr class="dropdown-divider" />
                            </li>


                            <li>

                                <form asp-area="Identity"
                                      asp-page="/Account/Logout"
                                      asp-route-returnUrl="@homeReturnUrl"
                                      method="post">

                                    <button type="submit"
                                            class="dropdown-item text-danger">

                                        <i class="bi bi-box-arrow-right me-2"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>

                        </ul>

                    </div>

                </div>

            </header>


            <!-- PAGE CONTENT -->

            <main class="tpw-main">

                <div class="tpw-content">

                    @RenderBody()

                </div>

            </main>


            <!-- FOOTER -->

            <footer class="tpw-footer">

                <span>
                    &copy; @DateTime.Now.Year Valav Boys Wallet.
                    All rights reserved.
                </span>

                <span class="tpw-footer-message">
                    Keep track
                    <span>•</span>
                    Split smart
                    <span>•</span>
                    Stay together 💜
                </span>

            </footer>

        </div>
    }
    else
    {
        <!-- =====================================================
             PUBLIC / LOGIN LAYOUT
             ===================================================== -->

        <div class="tpw-public">

            <header class="tpw-public-header">

                <div class="container">

                    <div class="tpw-public-nav">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="tpw-public-brand">

                            <span class="tpw-public-brand-icon">

                                <i class="bi bi-wallet2"></i>

                            </span>

                            <span>
                                Valav Boys
                                <strong>Wallet</strong>
                            </span>

                        </a>


                        <div class="tpw-public-actions">

                            <a class="tpw-login-link"
                               asp-area="Identity"
                               asp-page="/Account/Login">

                                Login

                            </a>

                            <a class="btn tpw-primary-btn"
                               asp-area="Identity"
                               asp-page="/Account/Register">

                                Create Account

                            </a>

                        </div>

                    </div>

                </div>

            </header>


            <main>

                @RenderBody()

            </main>


            <footer class="tpw-public-footer">

                <div class="container">

                    <div class="d-flex flex-column
                                flex-md-row
                                justify-content-between
                                gap-2">

                        <span>
                            &copy; @DateTime.Now.Year
                            Valav Boys Wallet
                        </span>

                        <span>
                            Same people. Different bills. 💜
                        </span>

                    </div>

                </div>

            </footer>

        </div>
    }


    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <script>

        function toggleSidebar() {

            const sidebar =
                document.getElementById("mainSidebar");

            const overlay =
                document.getElementById("sidebarOverlay");

            if (!sidebar || !overlay)
                return;

            const isOpen =
                sidebar.classList.toggle("show");

            overlay.classList.toggle("show", isOpen);

            document.body.classList.toggle(
                "tpw-sidebar-open",
                isOpen
            );
        }


        function closeSidebar() {

            const sidebar =
                document.getElementById("mainSidebar");

            const overlay =
                document.getElementById("sidebarOverlay");

            if (!sidebar || !overlay)
                return;

            sidebar.classList.remove("show");

            overlay.classList.remove("show");

            document.body.classList.remove(
                "tpw-sidebar-open"
            );
        }


        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {
                    closeSidebar();
                }

            }
        );


        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const sidebarLinks =
                    document.querySelectorAll(
                        ".tpw-sidebar .tpw-nav-link"
                    );

                sidebarLinks.forEach(function (link) {

                    link.addEventListener(
                        "click",
                        function () {

                            if (window.innerWidth < 992) {
                                closeSidebar();
                            }

                        }
                    );

                });

            }
        );


        window.addEventListener(
            "resize",
            function () {

                if (window.innerWidth >= 992) {
                    closeSidebar();
                }

            }
        );

    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>

</html>